                    }
                } break;

                case MenuTab::Miscellaneous: {
                    if (AnimatedButton("Network")) {
                        currentPage = MenuPages::Misc_Network;
                    }
                } break;
            }
            ImGui::EndChild();
        }

        ImGui::SameLine();

        if (ImGui::BeginChild("##Container", ImVec2(0.0f, 0.0f))) {
            switch (currentTab) {
