    inline std::vector<int> PatternToBytes(const char *pattern) noexcept {
        std::vector<int> bytes;

        const char *cur = pattern;

        while (*cur) {
            if (*cur == '?') {
                ++cur;

                if (*cur == '?')
                    ++cur;

                bytes.push_back(-1);
            } else {
                bytes.push_back(strtoul(cur, nullptr, 16));

                while (*cur && *cur != ' ')
                    ++cur;
            }

            while (*cur == ' ')
                ++cur;
        }

        return bytes;
    }

    inline uintptr_t FindPattern(
        const char *module,
        const char *pattern) noexcept {
